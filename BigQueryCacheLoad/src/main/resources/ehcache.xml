<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://www.ehcache.org/v3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.0.xsd">

    <persistence directory="${cache.disk.path}"/>

    <cache alias="myRecordCache">
        <key-type>java.lang.String</key-type>
        <value-type>com.apachecamel.bigquerycacheload.model.MyRecord</value-type>

        <expiry>
            <ttl unit="minutes">5</ttl>
        </expiry>

        <resources>
            <!-- Tier 1: On-heap — fastest, limited entries -->
            <heap unit="entries">100000</heap>

            <!-- Tier 2: Off-heap — 1 GB, spills from heap -->
            <offheap unit="GB">1</offheap>

            <!-- Tier 3: Disk — 10 GB persistent, spills from off-heap -->
            <disk unit="GB" persistent="true">10</disk>
        </resources>
    </cache>

</config>